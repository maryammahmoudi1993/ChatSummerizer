# Storage: "memory" (default) or "redis"
STORAGE_BACKEND=memory
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Optional: enables LLM summaries (otherwise an extractive fallback is used)
OPENAI_API_KEY=

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:8000

HOST=127.0.0.1
PORT=8000
DEBUG=false
LOG_LEVEL=INFO
